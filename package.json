{
    "name": "@synkestra/http-kit",
    "version": "2.0.2",
    "description": "Example HTTP helper library",
    "license": "UNLICENSED",
    "author": "Synkestra",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "packageManager": "pnpm@9.12.1",
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "prepublishOnly": "pnpm run build"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "express": "^5.2.1",
        "tsup": "^8.0.2",
        "typescript": "^5.4.5",
        "zod": "^4.3.6"
    },
    "peerDependencies": {
        "express": "^5.0.0",
        "zod": "^4.0.0"
    },
    "dependencies": {
        "@t3-oss/env-core": "^0.13.10",
        "cors": "^2.8.6",
        "jsonwebtoken": "^9.0.3",
        "prom-client": "^15.1.3"
    }
}